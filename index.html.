<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Catálogo de Coberturas | IOT — Protótipo</title><style>:root{font-family:system-ui,-apple-system,Segoe UI,sans-serif;color:#15354a;background:#f3f8fa}*{box-sizing:border-box}body{margin:0}header{background:linear-gradient(120deg,#087c91,#124e78);color:white;padding:28px 20px}main{max-width:980px;margin:auto;padding:22px 16px}.wrap{max-width:980px;margin:auto}.eyebrow{font-size:12px;letter-spacing:.12em;text-transform:uppercase;opacity:.86}h1{margin:8px 0;font-size:clamp(25px,5vw,37px)}h2{font-size:22px}p{line-height:1.55}.notice{background:#e8f5f6;border-left:4px solid #178a97;padding:12px 15px;border-radius:8px;font-size:14px}.toolbar{display:flex;gap:10px;flex-wrap:wrap;margin:20px 0}input,select{padding:13px 14px;border:1px solid #c9d9df;border-radius:10px;font-size:16px;background:white;flex:1;min-width:180px}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(215px,1fr));gap:16px}.card{background:white;border:1px solid #dce8ed;border-radius:16px;overflow:hidden;box-shadow:0 4px 14px #173a4b0b}.illustration{height:130px;display:grid;place-items:center;background:linear-gradient(135deg,#e7f3f6,#f6fbfc);font-size:50px}.content{padding:16px}.tag{display:inline-block;font-size:12px;color:#126578;background:#e8f4f6;padding:5px 9px;border-radius:20px}.card h3{margin:12px 0 6px}.card p{font-size:14px;color:#516b78;min-height:46px}button{border:0;background:#087d92;color:white;padding:11px 14px;border-radius:9px;font-weight:650;cursor:pointer}button:hover{background:#06677a}.details{margin-top:22px;background:white;padding:22px;border-radius:16px;border:1px solid #dce8ed}.details[hidden]{display:none}.kv{background:#f1f7f9;border-radius:9px;padding:12px;margin:12px 0}.pending{color:#9a611a;font-weight:650}.muted{color:#56717d}.back{background:#e6f2f5;color:#0b6075}a{color:#006b88}footer{margin-top:28px;padding:20px;text-align:center;font-size:12px;color:#59717c}@media(max-width:500px){header{padding:24px 16px}.details{padding:16px}}</style></head><body><header><div class="wrap"><div class="eyebrow">Educação Permanente · GIF · IOT</div><h1>Catálogo Digital de Coberturas</h1><div>Conheça os materiais e consulte as informações para solicitação no MV.</div></div></header><main><div class="notice"><strong>Protótipo para discussão institucional.</strong> Informações técnicas resumidas a partir do fabricante, ainda não validadas pelo GIF. Não utilizar como protocolo de indicação ou prescrição. Códigos MV e disponibilidade não confirmados.</div><section id="catalog"><h2>Encontre uma cobertura</h2><div class="toolbar"><input id="search" placeholder="Pesquisar por nome ou característica" aria-label="Pesquisar produtos"><select id="category" aria-label="Filtrar categoria"><option value="">Todas as categorias</option><option>Espuma</option><option>Hidrogel</option><option>Hidrocoloide</option><option>Filme com compressa</option></select></div><div class="grid" id="cards"></div><p id="empty" hidden>Nenhum produto encontrado.</p></section><section class="details" id="details" hidden aria-live="polite"></section><footer>Protótipo demonstrativo · Educação Permanente e GIF · IOT<br>Sem integração com MV · Sem informações de pacientes · Outubro de 2026</footer></main><script>const products=[{name:'Proximel Basic',category:'Espuma',icon:'▤',summary:'Curativo de espuma de poliuretano com bordas adesivas.',desc:'Espuma absorvente de poliuretano com filme protetor superior e bordas adesivas em poliacrilato.',ind:'Indicação institucional a definir após análise da ficha técnica e validação pelo GIF.',url:'https://www.hartmann.info/pt-br/topic/l/br/tratamento-de-feridas/proximel-basic'},{name:'HydroTac Transparent',category:'Hidrogel',icon:'◈',summary:'Cobertura transparente de gel hidratado.',desc:'Cobertura transparente de gel de poliuretano hidratado com glicerina, permitindo visualização da ferida.',ind:'O fabricante descreve uso em feridas secas ou com pouco exsudato, em granulação/epitelização; indicação institucional pendente de validação.',url:'https://www.hartmann.info/pt-br/products/tratamento-de-feridas/pensos-hidroativos/ap%C3%B3sito-de-hidrogel-%E2%80%90-cobertura/hydrotac%C2%AE-transparent-%28mdr%29'},{name:'Hydrocoll',category:'Hidrocoloide',icon:'▧',summary:'Curativo hidrocoloide autoadesivo e absorvente.',desc:'Hidrocoloide com carboximetilcelulose e camada externa de poliuretano.',ind:'O fabricante descreve uso em feridas com pouco a moderado exsudato; indicação institucional pendente de validação.',url:'https://www.hartmann.info/pt-br/topic/tratamento-de-feridas/hydrocoll'},{name:'Hydrofilm Plus',category:'Filme com compressa',icon:'▣',summary:'Filme estéril com compressa fina absorvente.',desc:'Filme autoadesivo de poliuretano com compressa absorvente não aderente à ferida.',ind:'O fabricante descreve uso em feridas pós-operatórias ou com pouco exsudato; indicação institucional pendente de validação.',url:'https://www.hartmann.info/pt-br/topic/l/br/tratamento-de-feridas/hydrofilm-plus'}];const cards=document.getElementById('cards'),details=document.getElementById('details'),catalog=document.getElementById('catalog');function render(){const q=document.getElementById('search').value.toLocaleLowerCase('pt-BR'),cat=document.getElementById('category').value;const filtered=products.filter(p=>(!cat||p.category===cat)&&[p.name,p.category,p.summary,p.desc].join(' ').toLocaleLowerCase('pt-BR').includes(q));cards.innerHTML=filtered.map(p=>`<article class="card"><div class="illustration" aria-hidden="true">${p.icon}</div><div class="content"><span class="tag">${p.category}</span><h3>${p.name}</h3><p>${p.summary}</p><button type="button" data-name="${p.name}">Ver ficha do produto →</button></div></article>`).join('');document.getElementById('empty').hidden=filtered.length>0;}cards.addEventListener('click',e=>{const btn=e.target.closest('button[data-name]');if(!btn)return;const p=products.find(x=>x.name===btn.dataset.name);catalog.hidden=true;details.hidden=false;details.innerHTML=`<button class="back" id="back">← Voltar ao catálogo</button><p><span class="tag">${p.category}</span></p><h2>${p.name}</h2><p>${p.desc}</p><div class="kv"><strong>Código MV</strong><p class="pending">A confirmar com Almoxarifado / MV</p></div><div class="kv"><strong>Indicação e cuidados</strong><p>${p.ind}</p></div><div class="kv"><strong>Validação técnica pelo GIF</strong><p class="pending">Pendente · Responsável e data a registrar</p></div><p><a href="${p.url}" target="_blank" rel="noopener noreferrer">Consultar ficha oficial da Hartmann ↗</a></p><p class="muted">Imagem oficial do produto será adicionada mediante fornecimento/autorização.</p>`;window.scrollTo({top:0,behavior:'smooth'});});details.addEventListener('click',e=>{if(e.target.id==='back'){details.hidden=true;catalog.hidden=false;window.scrollTo({top:0,behavior:'smooth'});}});document.getElementById('search').addEventListener('input',render);document.getElementById('category').addEventListener('change',render);render();</script></body></html>
